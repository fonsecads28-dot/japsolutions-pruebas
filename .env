# Configuración de Base de Datos Local (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./portero.db

# Credenciales de Desarrollo de LiveKit PC (Hacen match con el comando --dev)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WS_URL=ws://192.168.1.33:7880  # IP de la PC donde corre LiveKit, ajusta según tu red local

# Configuración del Broker MQTT para el Simulador de Relé
MQTT_BROKER=192.168.1.33 #
MQTT_PORT=1883

# Ruta del archivo de credenciales locales de Firebase
FIREBASE_JSON_PATH=firebase-credentials.json
